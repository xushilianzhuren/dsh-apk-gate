{
  "name": "dsh-apk-gate",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "原生APK编译闸插件：三路线判据、版本配对表、十坑速查、发版前七自查写成常驻提示；附工具链体检、项目鉴路、发版自查。",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}